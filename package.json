{
  "name": "doomr",
  "version": "0.1.0",
  "description": "A line-art, three-colour shooter demo built on Spock, BumpR, LoopR and RoostR",
  "keywords": [
    "game",
    "fps",
    "webgl",
    "raycasting"
  ],
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber",
    "url": "https://www.lcluber.com/"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0",
    "test": "node tests/levels.test.mjs && node tests/sim.test.mjs"
  },
  "dependencies": {
    "@1pizzateam/bumpr": "1.2.0",
    "@1pizzateam/groovr": "0.1.0-alpha.3",
    "@1pizzateam/loopr": "2.2.0",
    "@1pizzateam/roostr": "0.9.0",
    "@1pizzateam/spock": "4.5.0",
    "@dwtechs/ctrltab": "3.0.1"
  },
  "overrides": {
    "@1pizzateam/spock": "4.5.0"
  },
  "devDependencies": {
    "vite": "8.2.1"
  }
}
